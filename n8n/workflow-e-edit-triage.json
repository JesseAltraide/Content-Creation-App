    {
      "parameters": {
        "jsCode": "function words(s) { return (s || '').trim().split(/\\s+/).filter(Boolean); }\nfunction sentences(s) { return (s || '').split(/(?<=[.!?])\\s+/).map(x => x.trim()).filter(Boolean); }\nfunction lcsLength(a, b) {\n  const dp = Array.from({ length: a.length + 1 }, () => new Array(b.length + 1).fill(0));\n  for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) {\n    dp[i][j] = a[i - 1] === b[j - 1] ? dp[i - 1][j - 1] + 1 : Math.max(dp[i - 1][j], dp[i][j - 1]);\n  }\n  return dp[a.length][b.length];\n}\nconst anchorRows = $('Fetch Anchor Post').all().filter(i => i.json && i.json.id);\nconst currentRow = $('Fetch Current Channel Post').first().json;\nconst anchorText = anchorRows.length ? anchorRows[0].json.body : (currentRow.body || '');\nconst editedText = $('Config').first().json.edited_body;\nconst oldWords = words(anchorText);\nconst newWords = words(editedText);\nconst lcs = lcsLength(oldWords, newWords);\nconst editRatio = oldWords.length + newWords.length === 0 ? 0 : 1 - (2 * lcs) / (oldWords.length + newWords.length);\nconst oldNumerals = new Set((anchorText.match(/\\d+(\\.\\d+)?%?/g) || []));\nconst newNumerals = new Set((editedText.match(/\\d+(\\.\\d+)?%?/g) || []));\nconst numeralsChanged = oldNumerals.size !== newNumerals.size || [...oldNumerals].some(n => !newNumerals.has(n));\nconst oldSentences = sentences(anchorText);\nconst newSentenceSet = new Set(sentences(editedText));\nconst removedSentences = oldSentences.filter(s => !newSentenceSet.has(s));\nconst citationSentenceChanged = removedSentences.some(s => s.includes('[Source: excerpt'));\nconst wholeSentenceChanged = removedSentences.length > 0 || newSentenceSet.size !== oldSentences.length;\nconst mechanicalEscalate = numeralsChanged || citationSentenceChanged || wholeSentenceChanged || editRatio > 0.15;\nreturn [{ json: { anchorText, editedText, editRatio, numeralsChanged, citationSentenceChanged, wholeSentenceChanged, mechanicalEscalate, hasAnyEvaluation: anchorRows.length > 0 } }];"
      },
